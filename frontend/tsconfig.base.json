{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@spartan-ng/helm": ["./libs/shared/ui/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/shared/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/shared/ui/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/shared/ui/card/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
