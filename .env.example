# Casevanta configuration that can be overridden per machine.
#
# Nothing reads this file automatically. ASP.NET Core takes these values from environment variables
# (a double underscore separates configuration sections) or, for secrets, from user secrets:
#   dotnet user-secrets set "OpenIDConnectSettings:ClientSecret" "<value>" --project backend/src/Casevanta.Api
# The checked-in appsettings*.json files already hold working development defaults, so a normal
# local run needs none of this. Never put real credentials in this repository.

# --- BFF (backend/src/Casevanta.Api) ---
ASPNETCORE_ENVIRONMENT=Development
# OpenID Connect authority the BFF trusts. The AppHost injects all three values; set them only when
# running the BFF without Aspire against the development Keycloak (realm casevanta-workforce).
OpenIDConnectSettings__Authority=https://localhost:8080/realms/casevanta-workforce
OpenIDConnectSettings__ClientId=staff-web
# Leave empty here: the AppHost generates it per machine (parameter staff-web-client-secret)
OpenIDConnectSettings__ClientSecret=
# Public origin used for OIDC redirect URIs (the AppHost sets https://localhost:5001)
App__PublicOrigin=https://localhost:5001
# Angular dev server that the BFF proxies in Development
UiDevServerUrl=http://localhost:4201

# --- Browser journeys (apps/staff-web-e2e) ---
# Identity provider adapter
E2E_IDP=keycloak
